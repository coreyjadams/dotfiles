{{- /* chezmoi:modify-template */ -}}
{{- /* pi rewrites this file itself (deviceId, lastChangelogVersion, /settings).
       Only the keys in $managed are owned by chezmoi; everything else passes through. */ -}}
{{- $managed := dict
      "packages" (list (joinPath .chezmoi.homeDir ".local/share/pi-ext") "git:github.com/DietrichGebert/ponytail")
-}}
{{- $s := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $s = fromJson .chezmoi.stdin -}}{{- end -}}
{{- range $k, $v := $managed -}}{{- $s = setValueAtPath $k $v $s -}}{{- end -}}
{{- toPrettyJson "  " $s -}}

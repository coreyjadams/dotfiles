[".local/share/pi-ext"]
    type = "git-repo"
    url = "ssh://git@gitlab-master.nvidia.com:12051/coreya/pi.git"
    refreshPeriod = "168h"
    [".local/share/pi-ext".clone]
        args = ["--depth", "1"]
    [".local/share/pi-ext".pull]
        args = ["--ff-only"]

# blader/humanizer skill (MIT): one SKILL.md. From codeload, which stations reach too.
[".agents/skills/humanizer"]
    type = "archive"
    url = "https://codeload.github.com/blader/humanizer/tar.gz/refs/heads/main"
    exact = true
    stripComponents = 1
    include = ["*/SKILL.md", "*/LICENSE"]
    refreshPeriod = "168h"

{{- if and (hasKey . "github") (not .github) }}

# pi can't `git:` install ponytail where github.com is blocked, but codeload
# (tarballs) is reachable; modify_settings.json loads it from this path.
[".local/share/ponytail"]
    type = "archive"
    url = "https://codeload.github.com/DietrichGebert/ponytail/tar.gz/refs/heads/main"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{- else }}

[".local/share/blesh"]
    type = "archive"
    url = "https://github.com/akinomyoga/ble.sh/releases/download/v0.4.0-devel3/ble-0.4.0-devel3.tar.xz"
    exact = true
    stripComponents = 1
{{- end }}
